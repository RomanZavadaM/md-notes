{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "packages": {
    ".": {
      "release-type": "simple",
      "prerelease": true,
      "initial-version": "0.1.0",
      "release-as": "0.3.0",
      "package-name": "md-notes",
      "changelog-path": "CHANGELOG.md",
      "include-component-in-tag": false,
      "bump-minor-pre-major": true,
      "bump-patch-for-minor-pre-major": true,
      "changelog-sections": [
        { "type": "feat", "section": "Нові можливості" },
        { "type": "fix", "section": "Виправлення" },
        { "type": "perf", "section": "Продуктивність" },
        { "type": "docs", "section": "Документація" },
        { "type": "refactor", "section": "Рефакторинг", "hidden": true },
        { "type": "chore", "section": "Обслуговування", "hidden": true }
      ],
      "extra-files": [
        { "type": "toml", "path": "Cargo.toml", "jsonpath": "$.workspace.package.version" },
        { "type": "json", "path": "app/package.json", "jsonpath": "$.version" },
        { "type": "json", "path": "app/src-tauri/tauri.conf.json", "jsonpath": "$.version" }
      ]
    }
  }
}
