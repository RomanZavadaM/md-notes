{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MD Notes",
  "version": "0.3.0",
  "identifier": "io.github.romanzavadam.mdnotes",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "MD Notes",
        "width": 1200,
        "height": 800,
        "minWidth": 360,
        "minHeight": 400
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' asset: http://asset.localhost data: blob:; font-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'; object-src 'none'; base-uri 'none'; frame-src 'self' asset: http://asset.localhost; form-action 'none'",
      "assetProtocol": {
        "enable": true,
        "scope": []
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Productivity",
    "copyright": "Copyright © 2026 Roman Zavada (Роман Завада). All rights reserved.",
    "shortDescription": "Markdown knowledge base",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
