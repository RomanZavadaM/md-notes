{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Permissions of the main window and the detached graph window",
  "windows": [
    "main",
    "graph"
  ],
  "permissions": [
    "core:default",
    "dialog:default",
    "opener:default",
    "core:webview:allow-create-webview-window",
    "core:window:allow-set-focus",
    "core:window:allow-unminimize",
    "core:window:allow-show"
  ]
}
